{%- comment -%} Blog {%- endcomment -%}
{% style %}
  .blog-{{ section.id }} .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px,2vw,32px); }
  @media (max-width: 749px) { .blog-{{ section.id }} .blog-grid { grid-template-columns: 1fr; } }
  .blog-{{ section.id }} .article-card__media { aspect-ratio: 16/10; border-radius: var(--corner-radius); overflow: hidden; margin-bottom: 12px; }
  .blog-{{ section.id }} .article-card__title { font-size: 1.3rem; }
  .blog-{{ section.id }} .article-card__excerpt { color: var(--color-muted); }
{% endstyle %}

<section class="blog-{{ section.id }} section-spacing">
  <div class="page-width">
    <h1 data-text-reveal data-reveal="word">{{ blog.title }}</h1>
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card" data-animate style="--i: {{ forloop.index0 | modulo: 8 }};">
          {%- if article.image -%}
            <div class="article-card__media media">{% render 'responsive-image', image: article.image, sizes: '(max-width: 749px) 100vw, 33vw', widths: '400, 600, 800' %}</div>
          {%- endif -%}
          <h2 class="article-card__title">{{ article.title }}</h2>
          <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [

  ]
}
{% endschema %}
