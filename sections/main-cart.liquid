{%- comment -%} Pagina carrello {%- endcomment -%}
{% style %}
  .cart-{{ section.id }} .cart__title { font-size: calc(clamp(2rem, 5vw, 3.4rem) * var(--font-heading-scale)); margin-bottom: 24px; }
  .cart-{{ section.id }} .cart__empty { text-align: center; padding-block: 60px; }
  .cart-{{ section.id }} .cart__item {
    display: grid; grid-template-columns: 88px 1fr auto; gap: 16px; align-items: center;
    padding: 16px 0; border-bottom: 1px solid var(--color-border);
  }
  .cart-{{ section.id }} .cart__item-media { border-radius: var(--corner-radius); overflow: hidden; aspect-ratio: 1; }
  .cart-{{ section.id }} .cart__item-title { font-weight: 600; }
  .cart-{{ section.id }} .cart__qty { display: inline-flex; align-items: center; border: 1px solid var(--color-border); border-radius: var(--corner-radius); }
  .cart-{{ section.id }} .cart__qty input { width: 44px; text-align: center; background: transparent; color: var(--color-text); border: 0; font: inherit; padding: 8px 0; }
  .cart-{{ section.id }} .cart__foot { display: flex; justify-content: flex-end; align-items: center; gap: 24px; margin-top: 28px; flex-wrap: wrap; }
  .cart-{{ section.id }} .cart__subtotal { font-size: 1.4rem; font-weight: 700; }
{% endstyle %}

<section class="cart-{{ section.id }} section-spacing">
  <div class="page-width">
    <h1 class="cart__title" data-animate>{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart__items">
          {%- for item in cart.items -%}
            <div class="cart__item" data-animate style="--i: {{ forloop.index0 | modulo: 8 }};">
              <a href="{{ item.url }}" class="cart__item-media media">
                {%- if item.image -%}
                  {% render 'responsive-image', image: item.image, sizes: '88px', widths: '88, 176' %}
                {%- endif -%}
              </a>
              <div>
                <a href="{{ item.url }}" class="cart__item-title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <div class="text-muted">{{ item.variant.title }}</div>
                {%- endunless -%}
                <div class="text-muted">{{ item.final_price | money }}</div>
              </div>
              <div style="display:flex; align-items:center; gap:16px;">
                <div class="cart__qty">
                  <label class="visually-hidden" for="qty-{{ item.index | plus: 1 }}">{{ 'products.product.quantity' | t }}</label>
                  <input type="number" id="qty-{{ item.index | plus: 1 }}" name="updates[]" value="{{ item.quantity }}" min="0" onchange="this.form.submit()">
                </div>
                <a href="{{ item.url_to_remove }}" class="text-muted" aria-label="{{ 'cart.general.remove' | t }}">{% render 'icon', name: 'close' %}</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart__foot">
          <span class="text-muted">{{ 'cart.general.subtotal' | t }}</span>
          <span class="cart__subtotal">{{ cart.total_price | money }}</span>
          <button type="submit" name="checkout" class="btn">{{ 'cart.general.checkout' | t }}</button>
        </div>
      </form>
    {%- else -%}
      <div class="cart__empty" data-animate>
        <p>{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrello",
  "tag": "section",
  "settings": [

  ]
}
{% endschema %}
