{%- comment -%}
  ⭐ Sezione signature — Intro cinematografica "APNEA".

  Overlay a schermo intero mostrato una sola volta per sessione.
  La prima immagine è puro CSS (nero + coni di luce sfumati): costa zero,
  compare istantaneamente ed È già la prima battuta del concept. La scena
  WebGL viene caricata dopo l'evento load e sostituisce il fermo immagine
  con una dissolvenza lenta — se non arriva mai (niente WebGL, animazioni
  ridotte, rete assente), il fermo immagine resta ed è comunque una
  composizione finita, non un errore.

  Senza JavaScript l'overlay resta nascosto: il negozio è subito accessibile.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign water = s.water_color | default: '#05070a'
  assign light = s.light_color | default: '#cfe6f2'
  assign accent = s.accent_color | default: settings.color_accent | default: '#f2a900'
  assign skin = s.shark_color | default: '#1a2028'
-%}

{%- if s.enabled -%}
  {% style %}
    .intro {
      position: fixed;
      inset: 0;
      z-index: 10000;
      background: {{ water }};
      overflow: hidden;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition: opacity 1.1s cubic-bezier(.4,0,.2,1);
    }
    .intro[hidden] { display: none; }
    .intro.is-out { opacity: 0; pointer-events: none; }

    /* --- Fermo immagine CSS: la prima cosa che appare, costo zero --- */
    .intro__still {
      position: absolute;
      inset: -10%;
      opacity: 0;
      animation: intro-still-in 2.6s cubic-bezier(.4,0,.2,1) .35s forwards;
      transition: opacity 1.6s ease;
    }
    .intro__still::before,
    .intro__still::after {
      content: '';
      position: absolute;
      top: -30%;
      width: 26%;
      height: 150%;
      filter: blur(46px);
      transform-origin: top center;
    }
    .intro__still::before {
      left: 46%;
      background: linear-gradient(to bottom,
        {{ light | color_modify: 'alpha', 0.22 }} 0%,
        {{ light | color_modify: 'alpha', 0.07 }} 45%,
        transparent 82%);
      transform: rotate(7deg);
    }
    .intro__still::after {
      left: 18%;
      width: 18%;
      background: linear-gradient(to bottom,
        {{ accent | color_modify: 'alpha', 0.13 }} 0%,
        {{ accent | color_modify: 'alpha', 0.04 }} 40%,
        transparent 78%);
      transform: rotate(-9deg);
    }
    @keyframes intro-still-in { to { opacity: 1; } }
    /* Quando la scena 3D è viva, il fermo immagine si ritira. */
    .intro.is-live .intro__still { opacity: 0; }

    .intro__canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      opacity: 0;
      transition: opacity 1.8s cubic-bezier(.4,0,.2,1);
    }
    .intro.is-live .intro__canvas { opacity: 1; }

    /* Vignettatura sempre presente: tiene lo sguardo al centro anche nel
       fermo immagine, dove non c'è il post-processing WebGL. */
    .intro__vignette {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(ellipse at 50% 46%,
        transparent 30%,
        {{ water | color_modify: 'alpha', 0.55 }} 78%,
        {{ water }} 100%);
    }

    /* --- Tipografia: piccola, spaziata, in basso. Mai un titolo al centro. --- */
    .intro__ui {
      position: absolute;
      inset: auto 0 0 0;
      padding: 0 24px clamp(30px, 7vh, 68px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      pointer-events: none;
    }
    .intro__mark {
      font-family: var(--font-heading-family);
      font-size: 11px;
      letter-spacing: .46em;
      text-indent: .46em;
      text-transform: uppercase;
      color: {{ s.text_color }};
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 1.6s ease .1s, transform 1.6s cubic-bezier(.2,.8,.2,1) .1s;
    }
    .intro__enter {
      pointer-events: auto;
      background: none;
      border: 0;
      padding: 14px 4px 0;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      font-family: var(--font-body-family);
      font-size: 10px;
      letter-spacing: .34em;
      text-indent: .34em;
      text-transform: uppercase;
      color: {{ s.text_color }};
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 1.4s ease .35s, transform 1.4s cubic-bezier(.2,.8,.2,1) .35s;
    }
    .intro__enter::before {
      content: '';
      width: 1px;
      height: 34px;
      background: linear-gradient(to bottom, transparent, {{ s.text_color | color_modify: 'alpha', 0.55 }});
    }
    .intro__enter span { opacity: .62; transition: opacity .6s ease; }
    .intro__enter:hover span,
    .intro__enter:focus-visible span { opacity: 1; }

    .intro.is-open .intro__mark,
    .intro.is-open .intro__enter { opacity: 1; transform: translateY(0); }
    .intro.is-entering .intro__ui { opacity: 0; transition: opacity .5s ease; }

    .intro__skip {
      position: absolute;
      right: 20px;
      bottom: 20px;
      z-index: 4;
      background: none;
      border: 0;
      padding: 10px;
      cursor: pointer;
      font-family: var(--font-body-family);
      font-size: 9px;
      letter-spacing: .28em;
      text-transform: uppercase;
      color: {{ s.text_color }};
      opacity: 0;
      transition: opacity .8s ease;
    }
    .intro.is-open .intro__skip { opacity: .3; }
    .intro__skip:hover, .intro__skip:focus-visible { opacity: .8; }
    .intro.is-entering .intro__skip { opacity: 0; }

    /* --- Nero finale: la camera è dentro la bocca --- */
    .intro__black {
      position: absolute;
      inset: 0;
      z-index: 6;
      background: #000;
      opacity: 0;
      pointer-events: none;
      transition: opacity .42s cubic-bezier(.6,0,.9,.4);
    }
    .intro.is-black .intro__black { opacity: 1; }

    /* --- Riduzione del movimento: composizione ferma, nessuna animazione --- */
    @media (prefers-reduced-motion: reduce) {
      .intro__still { animation: none; opacity: 1; }
      .intro__mark, .intro__enter { transition-duration: .3s; }
      .intro, .intro__canvas, .intro__black { transition-duration: .3s; }
    }
    html.no-animations .intro__still { animation: none; opacity: 1; }
  {% endstyle %}

  {%- comment -%}
    Import map: three.js è vendorizzato in assets/ (nessuna origine di terze
    parti, cache Shopify, compatibile con CSP). GLTFLoader importa 'three' e
    'three-bufferutils' come specificatori nudi, risolti qui.
  {%- endcomment -%}
  <script type="importmap">
    {
      "imports": {
        "three": {{ 'three.module.js' | asset_url | json }},
        "three-bufferutils": {{ 'BufferGeometryUtils.js' | asset_url | json }}
      }
    }
  </script>

  <div
    class="intro"
    data-intro
    data-webgl="{{ s.enable_webgl | json }}"
    data-audio="{{ s.enable_audio | json }}"
    data-enter-duration="{{ s.enter_duration }}"
    data-reveal-at="{{ s.reveal_at }}"
    data-module-url="{{ 'intro-cinematic-3d.js' | asset_url }}"
    data-gltf-loader-url="{{ 'GLTFLoader.js' | asset_url }}"
    data-glb-url="{{ s.model_url }}"
    data-water-color="{{ water }}"
    data-light-color="{{ light }}"
    data-accent-color="{{ accent }}"
    data-shark-color="{{ skin }}"
    role="button"
    tabindex="0"
    aria-label="{{ 'sections.intro.aria_enter' | t }}"
    hidden
  >
    <div class="intro__still" aria-hidden="true"></div>
    <canvas class="intro__canvas" data-intro-canvas aria-hidden="true"></canvas>
    <div class="intro__vignette" aria-hidden="true"></div>

    <div class="intro__ui">
      {%- if s.wordmark != blank -%}
        <p class="intro__mark">{{ s.wordmark }}</p>
      {%- endif -%}
      <button type="button" class="intro__enter" data-intro-cta>
        <span>{{ s.cta_text }}</span>
      </button>
    </div>

    <button type="button" class="intro__skip" data-intro-skip>{{ 'sections.intro.skip' | t }}</button>
    <div class="intro__black" aria-hidden="true"></div>
  </div>

  <script>
    (function () {
      var el = document.querySelector('[data-intro]');
      if (!el) return;
      try {
        if (!sessionStorage.getItem('sudditalia_intro_seen')) {
          el.hidden = false;
          document.body.classList.add('intro-active');
        }
      } catch (e) { /* sessionStorage non disponibile: intro nascosta */ }
    })();
  </script>
  <script src="{{ 'intro-cinematic.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Intro cinematografica",
  "settings": [
    {
      "type": "paragraph",
      "content": "Immersione a schermo intero mostrata una volta per sessione. Scena WebGL con fallback automatico a un fermo immagine graduato. Nessun modello 3D da caricare: lo squalo è generato via codice."
    },
    { "type": "checkbox", "id": "enabled", "label": "Attiva intro", "default": true },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "SUDDITALIA",
      "info": "Testo piccolo e spaziato sopra l'invito. Lasciare vuoto per nasconderlo."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Invito",
      "default": "DIVE INTO SUDDITALIA",
      "info": "Alternative: \"ENTER SUDDITALIA\", \"WELCOME TO THE SOUTH\"."
    },
    { "type": "header", "content": "Scena 3D" },
    {
      "type": "checkbox",
      "id": "enable_webgl",
      "label": "Attiva scena WebGL",
      "default": true,
      "info": "Se disattivata (o se il dispositivo non la supporta) resta il fermo immagine graduato."
    },
    {
      "type": "checkbox",
      "id": "enable_audio",
      "label": "Audio all'ingresso",
      "default": true,
      "info": "Fiotto d'acqua e sub sintetizzati al click. Nessun file audio da caricare. Disattivato per chi richiede meno animazioni."
    },
    {
      "type": "url",
      "id": "model_url",
      "label": "Modello GLB (opzionale)",
      "info": "Carica un modello di squalo realistico in Impostazioni → File e incolla qui il link: sostituisce la mesh procedurale mantenendo identiche regia e sequenza. Assicurati che la licenza copra l'uso commerciale."
    },
    { "type": "header", "content": "Palette" },
    {
      "type": "color",
      "id": "water_color",
      "label": "Acqua profonda",
      "default": "#05070a",
      "info": "Colore di fondo e della foschia. Tenerlo molto scuro è ciò che rende l'immagine premium."
    },
    { "type": "color", "id": "light_color", "label": "Luce", "default": "#cfe6f2" },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accento (oro)",
      "default": "#f2a900",
      "info": "Usato solo come luce e riflesso, mai come colore di riempimento."
    },
    { "type": "color", "id": "shark_color", "label": "Pelle", "default": "#1a2028" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#e8e6e1" },
    { "type": "header", "content": "Tempi" },
    {
      "type": "range",
      "id": "reveal_at",
      "label": "L'invito compare dopo",
      "min": 1500,
      "max": 9000,
      "step": 250,
      "unit": "ms",
      "default": 4500
    },
    {
      "type": "range",
      "id": "enter_duration",
      "label": "Durata dell'ingresso",
      "min": 1400,
      "max": 4000,
      "step": 100,
      "unit": "ms",
      "default": 2200
    }
  ]
}
{% endschema %}
