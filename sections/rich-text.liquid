{%- comment -%} Blocco di testo libero {%- endcomment -%}
<section class="section-spacing" style="text-align: {{ section.settings.align }}; background: {{ section.settings.bg }};">
  <div class="page-width" style="max-width: {{ section.settings.width }}ch; {% if section.settings.align == 'center' %}margin-inline:auto;{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 data-text-reveal data-reveal="word" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="rte" data-animate {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <a href="{{ block.settings.link }}" class="btn {% if block.settings.style == 'outline' %}btn--outline{% endif %}" data-animate {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Testo libero",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Sfondo",
      "default": "#0e0e10"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Allineamento",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Sinistra"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ]
    },
    {
      "type": "range",
      "id": "width",
      "label": "Larghezza",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "ch",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Titolo",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Testo",
          "default": "Titolo"
        }
      ]
    },
    {
      "type": "text",
      "name": "Testo",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Testo",
          "default": "<p>Racconta la tua storia.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Bottone",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Testo",
          "default": "Scopri"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Stile",
          "default": "solid",
          "options": [
            {
              "value": "solid",
              "label": "Pieno"
            },
            {
              "value": "outline",
              "label": "Bordo"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testo libero",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
