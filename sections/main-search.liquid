{%- comment -%} Risultati ricerca {%- endcomment -%}
{% style %}
  .search-{{ section.id }} .search__form { display: flex; gap: 8px; max-width: 560px; margin-bottom: 32px; }
  .search-{{ section.id }} .search__form input {
    flex: 1; padding: 12px 16px; background: transparent; color: var(--color-text);
    border: 1px solid var(--color-border); border-radius: var(--corner-radius); font: inherit;
  }
  .search-{{ section.id }} .product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px,2vw,28px); }
  @media (max-width: 989px) { .search-{{ section.id }} .product-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 749px) { .search-{{ section.id }} .product-grid { grid-template-columns: repeat(2, 1fr); } }
{% endstyle %}

<section class="search-{{ section.id }} section-spacing">
  <div class="page-width">
    <h1 data-animate>{{ 'general.search.submit' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
      <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
      <input type="search" id="SearchInput" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, tilt: true, index: forloop.index0 %}
            {%- else -%}
              <a href="{{ item.url }}" class="product-card" data-animate>
                <h3 class="product-card__title">{{ item.title }}</h3>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p data-animate>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ricerca",
  "tag": "section",
  "settings": [

  ]
}
{% endschema %}
