{%- comment -%} Marquee / ticker a scorrimento infinito {%- endcomment -%}
{% style %}
  .marquee-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-block: {{ section.settings.padding }}px;
    border-block: 1px solid var(--color-border);
  }
  .marquee-{{ section.id }} .marquee__item {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    text-transform: var(--heading-transform);
    font-size: {{ section.settings.font_size }}px;
    letter-spacing: .04em;
    padding-inline: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
  }
  .marquee-{{ section.id }} .marquee__sep { color: var(--color-accent); }
{% endstyle %}

<div class="marquee-{{ section.id }} marquee" data-marquee data-direction="{{ section.settings.direction }}" role="marquee" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="marquee__track" style="--marquee-duration: {{ section.settings.speed }}s;">
    {%- for block in section.blocks -%}
      <span class="marquee__item" {{ block.shopify_attributes }}>
        {{ block.settings.text }}
        <span class="marquee__sep" aria-hidden="true">✦</span>
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee ticker",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Sfondo",
      "default": "#f2a900"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Testo",
      "default": "#0e0e10"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Dimensione testo",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding verticale",
      "min": 6,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Durata ciclo (più alto = più lento)",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "default": 24
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direzione",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Verso sinistra"
        },
        {
          "value": "right",
          "label": "Verso destra"
        }
      ]
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Etichetta accessibilità",
      "default": "Annunci"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Testo",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Testo",
          "default": "SUDDITALIA CLOTHING"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "item",
        "settings": {
          "text": "SUDDITALIA CLOTHING"
        }
      },
      {
        "type": "item",
        "settings": {
          "text": "STREETWEAR DAL SUD"
        }
      },
      {
        "type": "item",
        "settings": {
          "text": "NUOVO DROP"
        }
      },
      {
        "type": "item",
        "settings": {
          "text": "SPEDIZIONE GRATUITA"
        }
      }
    ]
  },
  "presets": [
    {
      "name": "Marquee ticker"
    }
  ]
}
{% endschema %}
