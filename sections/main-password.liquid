{%- comment -%} Pagina password (storefront protetto) {%- endcomment -%}
{% style %}
  .password-page { min-height: 100vh; display: grid; place-items: center; text-align: center; padding: 24px;
    background: radial-gradient(circle at 50% 40%, {{ section.settings.bg1 }} 0%, {{ section.settings.bg2 }} 100%); }
  .password-page__logo { max-width: 320px; margin: 0 auto 24px; }
  .password-page h1 { color: {{ section.settings.text_color }}; font-size: calc(clamp(2.4rem,7vw,5rem)*var(--font-heading-scale)); }
  .password-page p { color: {{ section.settings.text_color }}; opacity: .9; }
  .password-page form { display: flex; gap: 8px; justify-content: center; margin-top: 20px; flex-wrap: wrap; }
  .password-page input[type="password"] { padding: 12px 16px; border-radius: var(--corner-radius); border: 1px solid rgba(255,255,255,.4); background: rgba(255,255,255,.1); color: {{ section.settings.text_color }}; font: inherit; }
  .password-page .errors { color: #ffd7d0; margin-top: 8px; }
{% endstyle %}

<div class="password-page">
  <div>
    {%- if section.settings.image != blank -%}
      <div class="password-page__logo">{% render 'responsive-image', image: section.settings.image, sizes: '320px', widths: '320, 640', loading: 'eager' %}</div>
    {%- else -%}
      <div class="password-page__logo"><img src="{{ 'shark-logo-placeholder.svg' | asset_url }}" width="320" height="200" alt="{{ shop.name }}" loading="eager"></div>
    {%- endif -%}
    <h1>{{ shop.name }}</h1>
    <p>{{ section.settings.text }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <div class="errors">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</div>
      {%- endif -%}
      <label class="visually-hidden" for="Password">Password</label>
      <input type="password" id="Password" name="password" placeholder="Password" autocomplete="off">
      <button type="submit" class="btn">{{ 'general.accessibility.next' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Testo",
      "default": "Sta arrivando qualcosa di grosso. Iscriviti per l'anteprima."
    },
    {
      "type": "color",
      "id": "bg1",
      "label": "Sfondo centro",
      "default": "#4FB6E8"
    },
    {
      "type": "color",
      "id": "bg2",
      "label": "Sfondo bordi",
      "default": "#1C5C82"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Colore testo",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
