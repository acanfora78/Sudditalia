{%- comment -%} Elenco collezioni {%- endcomment -%}
{% style %}
  .collections-{{ section.id }} .collections-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px,2vw,28px); }
  @media (max-width: 749px) { .collections-{{ section.id }} .collections-grid { grid-template-columns: repeat(2, 1fr); } }
  .collections-{{ section.id }} .collection-tile { position: relative; border-radius: var(--corner-radius); overflow: hidden; aspect-ratio: 4/5; }
  .collections-{{ section.id }} .collection-tile img { transition: transform .6s var(--ease-out, ease); }
  .collections-{{ section.id }} .collection-tile:hover img { transform: scale(1.06); }
  .collections-{{ section.id }} .collection-tile__label {
    position: absolute; inset: auto 0 0 0; padding: 16px;
    background: linear-gradient(transparent, rgba(0,0,0,.7));
    color: #fff; font-family: var(--font-heading-family); text-transform: var(--heading-transform); font-size: 1.3rem;
  }
{% endstyle %}

<section class="collections-{{ section.id }} section-spacing">
  <div class="page-width">
    <h1 data-animate>{{ page_title }}</h1>
    <div class="collections-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-tile media" data-animate style="--i: {{ forloop.index0 | modulo: 8 }};">
          {%- if collection.featured_image -%}
            {% render 'responsive-image', image: collection.featured_image, sizes: '(max-width: 749px) 50vw, 33vw', widths: '400, 540, 720' %}
          {%- endif -%}
          <span class="collection-tile__label">{{ collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista collezioni",
  "tag": "section",
  "settings": [

  ]
}
{% endschema %}
