<section class="section-spacing"><div class="page-width">
  <h1 data-animate>{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p class="text-muted">{{ order.created_at | date: '%d %B %Y' }}</p>
  <table style="width:100%; border-collapse:collapse; margin-top:16px;">
    <thead><tr>
      <th style="text-align:left;padding:8px;">{{ 'customer.order.product' | t }}</th>
      <th style="text-align:left;padding:8px;">{{ 'customer.order.quantity' | t }}</th>
      <th style="text-align:left;padding:8px;">{{ 'customer.order.total' | t }}</th>
    </tr></thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr style="border-top:1px solid var(--color-border);">
          <td style="padding:8px;">{{ line_item.title }}</td>
          <td style="padding:8px;">{{ line_item.quantity }}</td>
          <td style="padding:8px;">{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
  <p style="margin-top:16px; text-align:right; font-weight:700;">{{ 'customer.order.total' | t }}: {{ order.total_price | money }}</p>
</div></section>
