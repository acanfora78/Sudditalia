<section class="section-spacing"><div class="page-width" style="max-width:460px;">
  <h1 data-animate>{{ 'customer.login.title' | t }}</h1>
  {%- form 'customer_login', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
    <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
    {%- if form.password_needed -%}
      <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
      <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password">
      <a href="#recover" onclick="document.getElementById('RecoverForm').style.display='block';return false;">{{ 'customer.login.forgot_password' | t }}</a>
    {%- endif -%}
    <button type="submit" class="btn" style="margin-top:16px;">{{ 'customer.login.sign_in' | t }}</button>
  {%- endform -%}

  <div id="RecoverForm" style="display:none; margin-top:24px;">
    {%- form 'recover_customer_password' -%}
      {{ form.errors | default_errors }}
      <h2>{{ 'customer.recover_password.title' | t }}</h2>
      <label for="RecoverEmail">{{ 'customer.recover_password.email' | t }}</label>
      <input type="email" id="RecoverEmail" name="email" autocomplete="email">
      <button type="submit" class="btn" style="margin-top:12px;">{{ 'customer.recover_password.submit' | t }}</button>
    {%- endform -%}
  </div>

  <p style="margin-top:24px;"><a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a></p>
</div></section>
{% style %}
  .account-form { display: flex; flex-direction: column; gap: 6px; }
  .account-form input { padding: 12px 14px; background: transparent; color: var(--color-text); border: 1px solid var(--color-border); border-radius: var(--corner-radius); font: inherit; margin-bottom: 8px; }
{% endstyle %}
