<section class="section-spacing"><div class="page-width" style="max-width:460px;">
  <h1 data-animate>{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <label for="pwd">{{ 'customer.reset_password.password' | t }}</label>
    <input type="password" id="pwd" name="customer[password]" autocomplete="new-password">
    <label for="pwd2">{{ 'customer.reset_password.password_confirmation' | t }}</label>
    <input type="password" id="pwd2" name="customer[password_confirmation]" autocomplete="new-password">
    <button type="submit" class="btn" style="margin-top:16px;">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div></section>
{% style %}
  .account-form { display:flex; flex-direction:column; gap:6px; }
  .account-form input { padding:12px 14px; background:transparent; color:var(--color-text); border:1px solid var(--color-border); border-radius:var(--corner-radius); font:inherit; margin-bottom:8px; }
{% endstyle %}
